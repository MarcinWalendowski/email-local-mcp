// Type-check the test files, which the build deliberately excludes.
//
// `tsconfig.json` drops `src/**/*.test.ts` so test code never lands in `dist/`
// (and therefore never inside the shipped `.app`). That would otherwise leave
// tests unchecked — tsx strips types, it does not verify them — so this config
// checks the same sources *including* the tests, and emits nothing. It runs as
// part of `npm run typecheck`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
