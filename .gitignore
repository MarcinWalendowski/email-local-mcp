# dependencies & build output
node_modules/
dist/
*.log
.DS_Store

# macOS app: generated project + build artifacts
app/*.xcodeproj/
app/build/
app/DerivedData/
*.app

# runtime config & secrets — these live in ~/.email-local-mcp and the Keychain,
# never in the repo; ignored here as belt-and-suspenders
.email-local-mcp/
.env
*.env

# Release artifacts (built by scripts/make-dmg.sh)
*.dmg

# email-local-core package artifacts. `core/dist` is covered by `dist/` above;
# LICENSE is copied in at pack time so the repo keeps exactly one copy of it.
core/LICENSE
email-local-core-*.tgz
