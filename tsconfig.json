{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"],
  // Tests are checked by tsconfig.test.json and run through tsx; they must not
  // be emitted into dist/, which is what ships inside the .app.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
